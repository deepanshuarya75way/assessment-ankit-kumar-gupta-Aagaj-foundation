# Dependency directories
**/node_modules/

# Local env files — NEVER commit real credentials
**/.env
**/.env.*
!**/.env.example
# Numbered env files (e.g. .env-1, .env-2) — these should never be committed
.env-*
**/.env-*

# Logs
**/logs
**/*.log
**/npm-debug.log*

# OS and Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local uploads (PDFs, images)
server/uploads/
dist/
dist-ssr/

# Secret scanning
.gitleaks.toml
