# SERVER ENVIRONMENT VARIABLES EXAMPLE
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# -------------------------------------------------
# SERVER CONFIG
# -------------------------------------------------
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# -------------------------------------------------
# DATABASE
# -------------------------------------------------
# MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>
# Local:         mongodb://localhost:27017/aagaz
MONGO_URI=mongodb://localhost:27017/aagaz

# -------------------------------------------------
# AUTHENTICATION
# -------------------------------------------------
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_strong_random_jwt_secret_here_change_this

# -------------------------------------------------
# RAZORPAY (Payment Gateway)
# -------------------------------------------------
# Obtain from: https://dashboard.razorpay.com/app/keys
# Use TEST keys (rzp_test_...) in development, LIVE keys in production ONLY
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET_HERE

# -------------------------------------------------
# CLOUDINARY (Image/File Storage)
# -------------------------------------------------
# Obtain from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -------------------------------------------------
# EMAIL (Nodemailer / Gmail App Password)
# -------------------------------------------------
# Use a Gmail App Password (not your main password): https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password_here

# -------------------------------------------------
# TEST / SEED CREDENTIALS (Development only)
# -------------------------------------------------
# These are used to seed a test hospital account on first DB boot
TEST_HOSPITAL_EMAIL=test_hospital@example.com
TEST_HOSPITAL_PASS=YourSecureTestPassword123

# -------------------------------------------------
# SMS GATEWAY (Choose one provider)
# -------------------------------------------------
# Options: 'fast2sms' | 'msg91' | 'twilio' | leave blank for DEV console logging
SMS_PROVIDER=

# FAST2SMS (Recommended for India DLT / Quick OTP)
# Obtain API key from: https://www.fast2sms.com/
FAST2SMS_API_KEY=YOUR_FAST2SMS_API_KEY_HERE

# MSG91 (Enterprise India SMS)
# Obtain Auth Key from: https://msg91.com/
MSG91_AUTH_KEY=YOUR_MSG91_AUTH_KEY_HERE
MSG91_WIDGET_ID=YOUR_MSG91_WIDGET_ID_HERE
MSG91_TEMPLATE_ID=YOUR_MSG91_OTP_TEMPLATE_ID_HERE

# TWILIO (Global SMS / WhatsApp)
# Obtain SID & Token from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_MESSAGING_SERVICE_SID=MGXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# -------------------------------------------------
# ADVANCED / OPTIONAL
# -------------------------------------------------
# Override rate limits if needed
# API_RATE_LIMIT=3000
# PAYMENT_RATE_LIMIT=200
# Trust proxy setting: 'true', '1', or leave blank
# TRUST_PROXY=1
# Fallback URL for serving uploads from production in dev
# PRODUCTION_FALLBACK_URL=https://www.aagajfoundation.com
